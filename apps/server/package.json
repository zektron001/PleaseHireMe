{
  "name": "@launchpad/server",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "../../scripts/run-server.sh dev",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --exclude '**/node_modules/**' --exclude '**/dist/**' --exclude '**/*.perf.test.ts'",
    "test:audit": "vitest run security.test.ts contract.test.ts property.test.ts",
    "test:baseline": "vitest run --exclude '**/node_modules/**' --exclude '**/dist/**' --exclude '**/*.perf.test.ts' --exclude '**/*.contract.test.ts' --exclude '**/*.property.test.ts' --exclude '**/security.test.ts' --exclude '**/client-contract.test.ts'",
    "test:fuzz": "FUZZ_RUNS=${FUZZ_RUNS:-20000} FUZZ_TIME_MS=${FUZZ_TIME_MS:-15000} vitest run property.test --testTimeout=0",
    "start": "../../scripts/run-server.sh start",
    "test:perf": "vitest run perf.test --testTimeout=0"
  },
  "dependencies": {
    "@fastify/cors": "^11.1.0",
    "@fastify/static": "^10.1.0",
    "fastify": "^5.6.2",
    "zod": "^4.1.13"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "@vitest/coverage-v8": "^4.1.11",
    "fast-check": "^4.9.0",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vitest": "^4.0.15"
  }
}
